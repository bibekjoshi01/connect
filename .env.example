# LOCAL DEVELOPMENT ONLY. Copy to .env; replace placeholders before startup.
# Compose reads this file explicitly via the root Makefile.
POSTGRES_DB=connect
POSTGRES_USER=connect
POSTGRES_PASSWORD=replace-with-local-random-value
REDIS_PASSWORD=replace-with-another-local-random-value
TURN_TEST_PASSWORD=replace-with-a-third-local-random-value
# Go uses this environment variable; make api-run supplies it.
API_LISTEN_ADDR=127.0.0.1:8080
