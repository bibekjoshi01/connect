# LOCAL DEVELOPMENT ONLY. Copy to .env; replace placeholders before startup.
# Compose reads this file explicitly via the root Makefile.
POSTGRES_DB=connect
POSTGRES_USER=connect
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-with-local-random-value
REDIS_PASSWORD=replace-with-another-local-random-value
TURN_TEST_PASSWORD=replace-with-a-third-local-random-value
# Go uses this environment variable; make api-run supplies it.
API_LISTEN_ADDR=127.0.0.1:8080
APP_ENV=development
# make api-run/api-migrate derive the local URL from POSTGRES_* above.
# A directly launched executable requires DATABASE_URL in its process environment.
# Remote databases require sslmode=verify-full; do not commit real credentials.
DB_MAX_OPEN_CONNS=8
DB_MAX_IDLE_CONNS=4
DB_CONNECT_TIMEOUT=2s
DB_STARTUP_TIMEOUT=10s
DB_READY_TIMEOUT=1s
DB_MIGRATION_TIMEOUT=30s
